# ============================================================
# ims-autogen 环境配置
# ============================================================
# 所有角色共用一套 API 时只需配置下方三行
# 如需为不同角色指定不同模型，详见下方的分角色配置

# ---------- 全局默认（所有角色共用）----------
API_KEY=sk-your-api-key
API_BASE=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat

# ---------- 分角色模型配置（可选）----------
# 取消注释并按需修改，优先级高于全局配置
# PM_MODEL_NAME=deepseek-chat
# ARCHITECT_MODEL_NAME=deepseek-chat
# DEVELOPER_MODEL_NAME=deepseek-chat
# QA_MODEL_NAME=deepseek-chat
# SELECTOR_MODEL_NAME=deepseek-chat   # 选择下一个发言者的模型

# ---------- 运行参数（可选）----------
# 最大发言轮数，防止无限循环（默认 100）
# MAX_TURNS=100
