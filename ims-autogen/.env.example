# ============================================================
# ims-autogen 环境配置
# ============================================================
# 最少只需配置下方两行
# ------------------------------------------------------------------
# 注意：API_BASE 必须以 /v1 结尾（OpenAI 兼容格式）
#   DeepSeek:    https://api.deepseek.com/v1
#   OpenAI:      https://api.openai.com/v1
#   硅基流动:     https://api.siliconflow.cn/v1
#   本地 Ollama:  http://localhost:11434/v1
# ------------------------------------------------------------------
API_KEY=sk-your-api-key
API_BASE=https://api.deepseek.com/v1
MODEL_NAME=deepseek-v4-flash

# ---------- 分角色模型配置（可选）----------
# 可为不同角色指定不同模型，未设置回退到全局 MODEL_NAME
# PM_MODEL_NAME=deepseek-v4-pro
# ARCHITECT_MODEL_NAME=deepseek-v4-pro
# DEVELOPER_MODEL_NAME=deepseek-v4-flash
# QA_MODEL_NAME=deepseek-v4-flash
# SELECTOR_MODEL_NAME=deepseek-v4-flash   # 选择下一个发言者的模型（建议用便宜快速的）

# ---------- 运行参数（可选）----------
# MAX_TURNS=100   # 最大发言轮数，防止无限循环
