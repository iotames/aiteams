# 进销存管理系统 — 环境变量配置模板
# 复制此文件为 .env 并填入真实值
#
# LLM 提供商配置（选其一即可，优先级从上到下）
# ── OpenAI ──
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1    # 自定义 OpenAI 兼容端点

# ── Anthropic ──
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── DeepSeek ──
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ── 其他 OpenAI 兼容 API（自定义 URL） ──
# 通过标准环境变量设置自定义端点，LiteLLM 自动识别
# OPENAI_API_KEY=sk-your-custom-key
# OPENAI_BASE_URL=https://your-custom-endpoint.com/v1
# MODEL_NAME=openai/your-model-name

# ── OpenRouter ──
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 模型选择（留空则使用对应 API 的默认模型）
# MODEL_NAME=gpt-4o

# 为不同角色分配不同模型（优先级高于 MODEL_NAME）
# ARCHITECT_LLM=deepseek/deepseek-v4-flash
# BACKEND_LLM=openai/gpt-4o-mini
# FRONTEND_LLM=openai/gpt-4o-mini

# 生成的应用配置
# DATABASE_URL=sqlite:///./ims.db    # SQLite（默认）
# DATABASE_URL=postgresql://user:pass@localhost:5432/ims  # PostgreSQL
